# ==============================================================================
# Letterboxd Streaming Alert - Environment Variables Example
# ==============================================================================

# The Movie Database (TMDB) API Key
# Sign up at https://www.themoviedb.org/ and get an API key under Account Settings -> API.
TMDB_API_KEY=your_tmdb_api_key_here

# Gmail SMTP Configuration (for sending email notifications)
# Sender must be a Gmail account with 2-Step Verification enabled.
# Generate an App Password at https://myaccount.google.com/apppasswords
SENDER_EMAIL=your_email@gmail.com
SENDER_APP_PASSWORD=your_16_character_app_password

# Recipient Email (where alerts will be sent)
RECIPIENT_EMAIL=your_email@gmail.com

# Letterboxd Settings
LETTERBOXD_USERNAME=kclyde
LETTERBOXD_WATCHLIST_URL=https://letterboxd.com/kclyde/watchlist/rss/

# Optional: Comma-separated list of streaming services (used in GitHub Actions or headless environments)
# If left empty, will load from config/services.txt
# STREAMING_SERVICES="Criterion Channel, Netflix, Max, Paramount Plus, Peacock, Disney Plus, Hulu, Apple TV Plus, Amazon Prime Video"

